# MySQL 자격증명 (docker-compose + 로컬 스크립트 공용)
# 사용법: cp .env.example .env 후 비밀번호를 실제 값으로 수정
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ecommerce
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me_app

# 호스트에서 직접 MySQL에 접속하는 스크립트(load_data.py 등)용
DB_HOST=127.0.0.1
DB_PORT=3306

# Debezium MySQL CDC 전용 계정 (init.sql에서 생성)
DBZ_USER=debezium
DBZ_PASSWORD=change_me_dbz
